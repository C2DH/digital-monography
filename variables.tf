variable "project_name" {
  type        = string
  description = "Global Name of the project"
  default     = "Another AWSome Project"
}

variable "region" {
  type        = string
  description = "AWS Region of the project"
  default     = "eu-west-1"
}

variable "environment" {
  type        = string
  description = "Environment/Branch of the Project"
}

## Set by the Dev team

variable "staticws_wip_bucket_name" {
  type        = string
  description = "Name of the bucket to which static website will be exported. E.g. domain_name."
}

variable "ir_apkg_html_bucket_name" {
  type        = string
  description = "Name of the bucket for intermediate format when transforming .docx into .html"
}

variable "ir_apkg_md_bucket_name" {
  type        = string
  description = "Name of the bucket for intermediate format when transforming .html into .md"
}

variable "archive_apkg_all_bucket_name" {
  type        = string
  description = "Name of the bucket for intermediate format when transforming .html into .md"
}

variable "upload_apkg_bucket_name" {
  type        = string
  description = "Name of the bucket for uploading authors' packages (apkg) to AWS cloud."
}

variable "upload_apkg_temp_bucket_name" {
  type        = string
  description = "Temp"
  default     = "upload-apkg-temp"
}

variable "verification_msgs_bucket_name" {
  type        = string
  description = "Name of the bucket for outputting the warning messages generated by the verifier Lambda."
}

variable "name" {
  description = "Application Name"
  type        = string
  default     = "sqs-integration"
}

locals {
  description = "Aplication Name"
  app_name    = "${var.name}-${var.environment}"
}

variable "lambda_name" {
  description = "Name for lambda function"
  default     = "lambda"
}

variable "cidr_block" {
  type = string
}

variable "builder_repo_name" {
  type        = string
  description = "Name of the ECR repository for the book builder image"
}

variable "entrypoint_repo_name" {
  type        = string
  description = "Name of the ECR repository for the entrypoint image"
}

variable "preparer_repo_name" {
  type        = string
  description = "Name of the ECR repository for the preparer image"
}

variable "github_repo_name" {
  type        = string
  description = "Name of the ECR repository for the github-caller image"
}

variable "verifier_repo_name" {
  type        = string
  description = "Name of the ECR repository for the verifier image"
}

variable "sqs_builder_trigger" {
  type        = string
  description = "Name of the SQS unique-id queue with messages to build a particular book"
}

locals {
  versions_data = jsondecode(file("${path.root}/.versions.json"))
}

variable "dgtmon_dev_dyndb_tokens_tbl" {
  type        = string
  description = "Name of the table for holding Dropbox account and access_token data"
}
