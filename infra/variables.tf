variable "project_name" {
  type        = string
  description = "Global Name of the project"
  default     = "Another AWSome Project"
}

variable "region" {
  type        = string
  description = "AWS Region of the project"
  default     = "eu-west-1"
}

variable "environment" {
  type        = string
  description = "Environment/Branch of the Project"
}

## Set by the Dev team

variable "staticws_wip_bucket_name" {
  type        = string
  description = "Name of the bucket to which static website will be exported. E.g. domain_name."
}

variable "staticws_dashboard_bucket_name" {
  type        = string
  description = "Name of the bucket to which dashboard website will be exported."
}

variable "ir_apkg_html_bucket_name" {
  type        = string
  description = "Name of the bucket for intermediate format when transforming .docx into .html"
}

variable "ir_apkg_md_bucket_name" {
  type        = string
  description = "Name of the bucket for intermediate format when transforming .html into .md"
}

# variable "archive_apkg_all_bucket_name" {
#   type        = string
#   description = "Name of the bucket for S3 archiving an author's package protected with versioning, object locks and archive policy."
# }

variable "upload_apkg_bucket_name" {
  type        = string
  description = "Name of the bucket for uploading authors' packages (apkg) to AWS cloud."
}

variable "upload_apkg_temp_bucket_name" {
  type        = string
  description = "Temp"
  default     = "upload-apkg-temp"
}

variable "metadata_assets_bucket_name" {
  type        = string
  description = "Name of the bucket for storing metadata of assets."
}

variable "verification_msgs_bucket_name" {
  type        = string
  description = "Name of the bucket for outputting the warning messages generated by the verifier Lambda."
}

variable "name" {
  description = "Application Name"
  type        = string
  default     = "sqs-integration"
}

locals {
  description = "Aplication Name"
  app_name    = "${var.name}-${var.environment}"
}

variable "lambda_name" {
  description = "Name for lambda function"
  default     = "lambda"
}

variable "cidr_block" {
  type = string
}

variable "builder_repo_name" {
  type        = string
  description = "Name of the ECR repository for the book builder image"
}

variable "entrypoint_repo_name" {
  type        = string
  description = "Name of the ECR repository for the entrypoint image"
}

variable "dropbox_repo_name" {
  type        = string
  description = "Name of the ECR repository for the dropbox-caller image"
}

variable "preparer_repo_name" {
  type        = string
  description = "Name of the ECR repository for the preparer image"
}

variable "github_repo_name" {
  type        = string
  description = "Name of the ECR repository for the github-caller image"
}

variable "verifier_repo_name" {
  type        = string
  description = "Name of the ECR repository for the verifier image"
}

variable "gpu_repo_name" {
  type        = string
  description = "Name of the ECR repository for the gpu (generate pre-signed url) image"
}

variable "sqs_github_trigger" {
  type        = string
  description = "Name of the SQS unique-id queue with messages to trigger push to github"
}

variable "sqs_builder_trigger" {
  type        = string
  description = "Name of the SQS unique-id queue with messages to build a particular book"
}

variable "sqs_entrypoint_to_dropbox" {
  type        = string
  description = "Name of the SQS queue for notifications when Dropbox was updated (send from entrypoint to dropbox)"
}

locals {
  versions_data = jsondecode(file("${path.root}/.versions.json"))
}

variable "dgtmon_dev_dyndb_tokens_tbl" {
  type        = string
  description = "Name of the table for holding Dropbox account and access_token data"
}

variable "dgtmon_dev_dyndb_cursors_tbl" {
  type        = string
  description = "Name of the table for holding Dropbox account and cursor data (relevant for DBX `/files/list_folder/continue`)"
}

variable "dgtmon_dev_dyndb_audit_tbl" {
  type        = string
  description = "Name of the table to log audit trail of checkpoints reached"
}

variable "dgtmon_dev_dyndb_alerts_tbl" {
  type        = string
  description = "Name of the table to log the last known status of the most crucial services"
}

variable "dgtmon_dev_dyndb_logins_tbl" {
  type        = string
  description = "Name of the table to monitor the logins of the users"
}

variable "dgtmon_dev_dyndb_assets_tbl" {
  type        = string
  description = "Name of the table for editors managing the status of assets"
}

variable "dgtmon_dev_dyndb_headings_tbl" {
  type        = string
  description = "Name of the table for editors to list publication's headings"
}

variable "dgtmon_dev_dyndb_citations_tbl" {
  type        = string
  description = "Name of the table for editors to list publication's citations"
}

variable "dgtmon_dev_dyndb_warnings_tbl" {
  type        = string
  description = "Name of the table for editors to list publication's warnings"
}
