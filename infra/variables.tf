## Set by the Admin

variable "aws_account_id" {
  type        = string
  description = "Identifier of the AWS account"
}

variable "region" {
  type        = string
  description = "AWS Region of the project"
  default     = "eu-central-1"
}

variable "project" {
  type        = string
  description = "Global name of the project, which acts as a prefix to all resources"
}

variable "org" {
  type        = string
  description = "Global name of the organization, mostly acts as a tag to all resources in an org"
}

variable "env" {
  type        = string
  description = "Name of the environment of the project read from git branch in CI/CD pipeline (i.e. main or develop)"
}

variable "dropbox_app_dir" {
  type        = string
  description = "App folder name matching one of the apps defined in https://www.dropbox.com/developers/apps/"
}

variable "dropbox_app_key" {
  type        = string
  description = "App key matching one of the apps defined in https://www.dropbox.com/developers/apps/"
}

variable "flask_secret_key" {
  type        = string
  description = "Flask secret key that will be used for securely signing session cookies"
}

## Set by the Dev team

variable "efs_access_security_group" {
  type        = string
  description = "Name of the security group for the shared file system"
}

variable "efs_creation_token" {
  type        = string
  description = "Name of the creation token for the shared file system"
}

variable "staticws_wip_bucket_name" {
  type        = string
  description = "Name of the bucket to which static website will be exported. E.g. domain_name."
}

variable "staticws_dashboard_bucket_name" {
  type        = string
  description = "Name of the bucket to which dashboard website will be exported."
}

variable "ir_apkg_html_bucket_name" {
  type        = string
  description = "Name of the bucket for intermediate format when transforming .docx into .html"
}

variable "ir_apkg_md_bucket_name" {
  type        = string
  description = "Name of the bucket for intermediate format when transforming .html into .md"
}

# variable "archive_apkg_all_bucket_name" {
