---
import { assets as a01 } from "../data/guidelines-for-drafting-manuscripts/01_general.json";
import { assets as a02 } from "../data/guidelines-for-drafting-manuscripts/02_introduction_to_docx.json";
import { assets as a03 } from "../data/guidelines-for-drafting-manuscripts/03_docx_advanced_elements.json";
import { assets as a04 } from "../data/guidelines-for-drafting-manuscripts/04_interactivity_in_docx.json";
import { assets as a06 } from "../data/guidelines-for-drafting-manuscripts/06_help.json";
import { assets as a07 } from "../data/guidelines-for-drafting-manuscripts/07_appendix_manuscript_template.json";

function getLastPart(s: string) {
    if (s) {
        let netArr = s.split("/");
        return netArr[netArr.length - 1];
    } else {
        return s;
    }
}

let assets = Object.values({
    "01_general": a01,
    "02_introduction_to_docx": a02,
    "03_docx_advanced_elements": a03,
    "04_interactivity_in_docx": a04,
    "06_help": a06,
    "07_appendix_manuscript_template": a07,
})
    .flat()
    .map((rec) => ({
        ...rec,
        digitalsource: getLastPart(rec.digitalsource),
        location: getLastPart(rec.location),
    }));
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro</title>
    </head>
    <body>
        <a href="/">Home</a>
        <a href="/assets/">Assets</a>
        <a href="/headings/">Headings</a>
        <a href="/citations/">Citations</a>
        <a href="/warnings/">Warnings</a>

        <h1>Assets</h1>

        {
            assets && (
                <table style="border: 1px solid; width: 100%; border-collapse: collapse;">
                    <thead>
                        <th style="border: 1px solid">Name (for digital)</th>
                        <th style="border: 1px solid">Location</th>
                        <th style="border: 1px solid">License</th>
                        <th style="border: 1px solid">Is on paper?</th>
                        <th style="border: 1px solid">Is ready?</th>
                    </thead>

                    <tbody>
                        {Object.values(assets).map((val) => (
                            <tr>
                                <td style="border: 1px solid">
                                    {val.digitalsource}
                                </td>
                                <td style="border: 1px solid">
                                    {val.location}
                                </td>
                                <td style="border: 1px solid">
                                    {val.licensename}
                                </td>
                                <td style="border: 1px solid">
                                    {val.papersource ? "✅" : "❌"}
                                </td>
                                <td style="border: 1px solid">
                                    {val.isready ? "✅" : "❌"}
                                </td>
                            </tr>
                        ))}
                    </tbody>
                </table>
            )
        }
    </body>
</html>
