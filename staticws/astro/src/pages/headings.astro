---
import { headings as a01 } from "../data/guidelines-for-drafting-manuscripts/01_general.json";
import { headings as a02 } from "../data/guidelines-for-drafting-manuscripts/02_introduction_to_docx.json";
import { headings as a03 } from "../data/guidelines-for-drafting-manuscripts/03_docx_advanced_elements.json";
import { headings as a04 } from "../data/guidelines-for-drafting-manuscripts/04_interactivity_in_docx.json";
import { headings as a06 } from "../data/guidelines-for-drafting-manuscripts/06_help.json";
import { headings as a07 } from "../data/guidelines-for-drafting-manuscripts/07_appendix_manuscript_template.json";

const headings = {
    "01_general": a01,
    "02_introduction_to_docx": a02,
    "03_docx_advanced_elements": a03,
    "04_interactivity_in_docx": a04,
    "06_help": a06,
    "07_appendix_manuscript_template": a07,
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro</title>
    </head>
    <body>
        <a href="/">Home</a>
        <a href="/assets/">Assets</a>
        <a href="/headings/">Headings</a>
        <a href="/citations/">Citations</a>
        <a href="/warnings/">Warnings</a>

        <h1>Headings</h1>

        {
            headings &&
                Object.entries(headings).map(([key, values]) => (
                    <>
                        <ul>
                            <b>{key}.docx</b>
                            {values.map((val) => (
                                <li>
                                    <span style="color: white">
                                        {"-----".repeat(Number(val.level[1]))}
                                    </span>
                                    {val.text}
                                </li>
                            ))}
                        </ul>
                    </>
                ))
        }

        <h2>Ideas</h2>
        <ul>
            <li>
                <a href="https://jsfiddle.net/tomaskafka/ur1hvzy3/"
                    >Static tree view</a
                >
            </li>
            <li>
                <a
                    href="https://gist.github.com/SuryaSankar/17c09f5e257207f8f937e4fefc47cb63#file-listree-full-html"
                    >Dynamic tree view</a
                >
            </li>
        </ul>
    </body>
</html>
