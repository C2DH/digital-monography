---
import { headings as a00 } from "../data/for-a-new-hermeneutics-of-practice/00_index.json";
import { headings as a01 } from "../data/for-a-new-hermeneutics-of-practice/01_abstract.json";
import { headings as a02 } from "../data/for-a-new-hermeneutics-of-practice/02_acknowledgements.json";
import { headings as a03 } from "../data/for-a-new-hermeneutics-of-practice/03_introduction.json";
import { headings as a04 } from "../data/for-a-new-hermeneutics-of-practice/04_ch1_framework-theory-and-working-concepts.json";
import { headings as a05 } from "../data/for-a-new-hermeneutics-of-practice/05_ch2_shaping-the-memorecord-digital-memory-platform.json";
import { headings as a06 } from "../data/for-a-new-hermeneutics-of-practice/06_ch3_analysing-digital-methods-a-return-to-hermeneutics.json";
import { headings as a07 } from "../data/for-a-new-hermeneutics-of-practice/07_ch4_the-historians-kitchen-or-how-to-cook-your-memories.json";

const headings = {
    "00_index": a00,
    "01_abstract": a01,
    "02_acknowledgements": a02,
    "03_introduction": a03,
    "04_ch1_framework-theory-and-working-concepts": a04,
    "05_ch2_shaping-the-memorecord-digital-memory-platform": a05,
    "06_ch3_analysing-digital-methods-a-return-to-hermeneutics": a06,
    "07_ch4_the-historians-kitchen-or-how-to-cook-your-memories": a07,
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
        <meta name="viewport" content="width=device-width" />
        <meta name="generator" content={Astro.generator} />
        <title>Astro</title>
    </head>
    <body>
        <a href="/">Home</a>
        <a href="/assets/">Assets</a>
        <a href="/headings/">Headings</a>
        <a href="/tables/">Tables</a>
        <a href="/citations/">Citations</a>
        <a href="/stats/">Statistics</a>
        <a href="/warnings/">Warnings</a>

        <h1>Headings</h1>

        {
            headings &&
                Object.entries(headings).map(([key, values]) => (
                    <>
                        <ul>
                            <b>{key}.docx</b>
                            {values.map((val) => (
                                <li>
                                    <span style="color: white">
                                        {"-----".repeat(Number(val.level[1]))}
                                    </span>
                                    {val.text}
                                </li>
                            ))}
                        </ul>
                    </>
                ))
        }

        <h2>Ideas</h2>
        <ul>
            <li>
                <a href="https://jsfiddle.net/tomaskafka/ur1hvzy3/"
                    >Static tree view</a
                >
            </li>
            <li>
                <a
                    href="https://gist.github.com/SuryaSankar/17c09f5e257207f8f937e4fefc47cb63#file-listree-full-html"
                    >Dynamic tree view</a
                >
            </li>
        </ul>
    </body>
</html>
