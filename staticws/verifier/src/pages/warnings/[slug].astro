---
import Layout from "../../layouts/Layout.astro";
import MsgsPerFile from "../../components/MsgsPerFile.jsx";
export function getStaticPaths() {
    return [{ params: { slug: "examples" } }];
}

const { slug } = Astro.params;
---

<Layout title="Warnings raised by the verifier.">
    <div class="container">
        <h1>mono[graph]</h1>
        <p>Verification messages from the '{slug}' book.</p>

        <MsgsPerFile file="verification_breaks.json" client:load />
    </div>
</Layout>
